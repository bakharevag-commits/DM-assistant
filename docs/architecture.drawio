        <mxCell id="e3lbl" value="JSON-RPC (MCP)&#10;задачи очереди, статусы, спринты" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e3">
